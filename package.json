{
  "name": "billio-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "next build",
    "start": "next start",
    "test": "npx vitest run -c vitest.unit.config.ts",
    "test:integration": "cross-env ENV_FILE=.env.integration npx vitest run -c vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "format": "npx prettier --write .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "api:contract": "tsx scripts/api-contract.ts --write",
    "api:contract:check": "tsx scripts/api-contract.ts --check",
    "verify": "npm run api:contract:check && npm run lint && npm run typecheck && npm run test:all",
    "db:init": "tsx lib/db/init-db.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.17.3",
    "@vitest/coverage-v8": "^4.1.9",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.1",
    "vitest": "^4.1.9",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
